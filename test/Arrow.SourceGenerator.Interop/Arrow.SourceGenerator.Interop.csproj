<Project Sdk="Microsoft.NET.Sdk">
    <!--
    The C# half of the external interoperability gate (docs/05-COMPATIBILITY.md). CI runs:

      dotnet run (this project) write FILE, then: uv run scripts/pyarrow_interop.py verify FILE
      uv run scripts/pyarrow_interop.py produce FILE, then: dotnet run (this project) read FILE
  -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Arrow.SourceGenerator.Interop</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Apache.Arrow" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Arrow.SourceGenerator.Attributes\Arrow.SourceGenerator.Attributes.csproj" />
        <ProjectReference
            Include="..\..\src\Arrow.SourceGenerator\Arrow.SourceGenerator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>
</Project>
