<Project Sdk="Microsoft.NET.Sdk">
    <!--
    Consumes the packages produced by `dotnet pack` from ../../artifacts. Run by CI after packing:

      dotnet run -f net10.0 -p:GeneratorPackageVersion=<version>

    Apache.Arrow is deliberately not referenced by default: it must arrive transitively through the
    Attributes package, exactly as it does for a consumer who installs only Arrow.SourceGenerator.
    ApacheArrowVersion lifts it to a specific release for the supported-version matrix
    (docs/05-COMPATIBILITY.md), compiling the same consumer against the newest intended release.
  -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GeneratorPackageVersion Condition="'$(GeneratorPackageVersion)' == ''"
            >0.0.1</GeneratorPackageVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Arrow.SourceGenerator" Version="$(GeneratorPackageVersion)" />
        <PackageReference
            Include="Apache.Arrow"
            Version="$(ApacheArrowVersion)"
            Condition="'$(ApacheArrowVersion)' != ''"
        />
    </ItemGroup>
</Project>
