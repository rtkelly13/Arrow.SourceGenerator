<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Arrow.SourceGenerator.Benchmarks</RootNamespace>
        <!-- BenchmarkDotNet generates and builds its own project; keep ours optimized. -->
        <Optimize>true</Optimize>
        <Configuration>Release</Configuration>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
        <PackageReference Include="Apache.Arrow" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Arrow.SourceGenerator.Attributes\Arrow.SourceGenerator.Attributes.csproj" />
        <ProjectReference
            Include="..\..\src\Arrow.SourceGenerator\Arrow.SourceGenerator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>
</Project>
